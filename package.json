{
  "name": "decky-wireguard",
  "version": "0.1.0",
  "private": true,
  "description": "Manage existing NetworkManager WireGuard connections from Decky Loader.",
  "type": "module",
  "scripts": {
    "build": "npm run typecheck && rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "test": "python3 -m unittest discover -s tests -v",
    "package": "npm run build && python3 tools/package.py"
  },
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "rollup": "^4.53.3",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  }
}
